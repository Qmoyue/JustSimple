<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.just</groupId>
    <artifactId>justsimple-parent</artifactId>
    <version>0.1.0</version>
  </parent>
  <artifactId>justsimple</artifactId>
  <name>JustSimple Scanner</name>
  <dependencies>
    <dependency><groupId>org.ow2.asm</groupId><artifactId>asm-tree</artifactId><version>9.8</version></dependency>
    <dependency><groupId>org.ow2.asm</groupId><artifactId>asm-analysis</artifactId><version>9.8</version></dependency>
    <dependency><groupId>com.google.code.gson</groupId><artifactId>gson</artifactId><version>2.13.2</version></dependency>
  </dependencies>
  <build>
    <resources>
      <resource><directory>src/main/resources</directory></resource>
      <resource>
        <directory>${project.basedir}/../docs</directory>
        <includes>
          <include>THIRD_PARTY_NOTICES.md</include>
          <include>licenses/*.txt</include>
        </includes>
        <targetPath>META-INF/JustSimple</targetPath>
      </resource>
      <resource>
        <directory>${project.basedir}/..</directory>
        <includes><include>LICENSE</include></includes>
        <targetPath>META-INF/JustSimple</targetPath>
      </resource>
    </resources>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId>
        <configuration><forceCreation>true</forceCreation></configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId><version>3.6.0</version>
        <executions><execution><phase>package</phase><goals><goal>shade</goal></goals><configuration>
          <createDependencyReducedPom>false</createDependencyReducedPom>
          <filters><filter><artifact>*:*</artifact><excludes><exclude>META-INF/*.SF</exclude><exclude>META-INF/*.RSA</exclude><exclude>META-INF/*.DSA</exclude><exclude>module-info.class</exclude><exclude>META-INF/versions/**/module-info.class</exclude></excludes></filter></filters>
          <transformers><transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer"><mainClass>io.just.app.Main</mainClass></transformer></transformers>
        </configuration></execution></executions>
      </plugin>
    </plugins>
  </build>
</project>
