{
  "name": "justsimple",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "engines": { "node": ">=22.19.0", "pnpm": "11.x" },
  "exports": {
    ".": {
      "types": "./agent/dist/tools.d.ts",
      "import": "./agent/dist/tools.js"
    }
  },
  "scripts": {
    "agent": "node agent/dist/cli.js",
    "build": "tsc -p agent",
    "check": "pnpm check:repo && tsc -p agent --noEmit",
    "check:repo": "node scripts/check-repo.mjs",
    "test": "pnpm test:repo && node --test agent/test/*.test.ts",
    "test:repo": "node --test scripts/check-repo.test.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
